# Bloom House — local development environment
# 1. Copy this file: cp .env.local.example .env.local
# 2. Fill in required secrets (marked REQUIRED below)
# 3. For demo-only mode, only SUPABASE_* + ANTHROPIC_API_KEY + DEMO_SIGNING_SECRET are needed
# 4. Generate signing secrets: openssl rand -hex 32

# === SUPABASE ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === AI ===
ANTHROPIC_API_KEY=
# OpenAI is used as the circuit-breaker fallback when Claude is unavailable.
# Without this, AI_FORCE_FALLBACK has no effect and forced-fallback calls fail.
OPENAI_API_KEY=
# Set '1' (or 'true'/'yes') to always route AI calls through OpenAI — useful
# for debugging the fallback path without tripping the circuit breaker.
AI_FORCE_FALLBACK=
# Set '1' to disable the OpenAI fallback entirely so all calls fail fast when
# Claude is unavailable (useful in cost-sensitive or compliance environments).
AI_DISABLE_FALLBACK=
# Where to send operator alerts when the OpenAI fallback fires or both
# providers fail. Rate-limited to one email per kind per 15 min. If blank,
# the alert is still logged (opsAlert breadcrumb) but no email is sent.
OPS_ALERT_EMAIL=

# === GOOGLE (Gmail OAuth) ===
# Used by /api/gmail/oauth/start + /api/gmail/oauth/callback (GAP-13).
# Obtain at https://console.cloud.google.com/apis/credentials. Add the
# GOOGLE_OAUTH_REDIRECT_URI value below to the OAuth client's "Authorized
# redirect URIs" list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit override. If unset, the callback infers
# `${origin}/api/gmail/oauth/callback`. Set this in production so behind-
# proxy or custom-domain deployments don't infer the wrong origin.
GOOGLE_OAUTH_REDIRECT_URI=
# HMAC key used to sign the OAuth `state` parameter so the callback can
# trust venue_id + user_id without round-tripping through the database.
# REQUIRED in production. Must be at least 16 chars. Rotate by setting a
# new value — outstanding OAuth flows fail open with `bad_state_bad_signature`.
#
# Signs every OAuth state in the app, not only Gmail: Google Ads, Meta Ads,
# TikTok Ads, Instagram and Zoom all use it (src/lib/services/integrations/
# oauth-state.ts). Fails CLOSED when unset — /start answers 503 or throws
# rather than signing with a fallback key, and every callback refuses the
# state with `not_configured`. There is no dev default any more.
# Generate with: openssl rand -hex 32
STATE_SIGNING_SECRET=

# === EXTERNAL DATA ===
NOAA_CDO_TOKEN=
FRED_API_KEY=
# SerpAPI powers the wedding-trend fetcher in lib/services/trends.ts.
# Without it, both fetchTrendsForVenue and fetchTrendsForAllVenues log a
# warning and return early — Sage intelligence context loses its "couples
# in your market are searching for X" signal. Get a key at
# https://serpapi.com (free tier = 100 searches/month, plenty for daily
# trend refreshes across a handful of venues). The var name must match
# Vercel's existing entry exactly — SERPAPI_API_KEY (not SERPAPI_KEY).
SERPAPI_API_KEY=

# Optional. Census ACS5 queries work without a key but are rate-limited. Request one at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# === MULTI-TENANT ROUTING ===
# Base domain used in middleware to derive per-venue subdomains.
# In dev this is typically 'localhost:3000'; in prod it should be your apex domain.
# Falls back to 'bloomhouse.ai' if unset — set it explicitly in production.
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000
# Canonical hostname for the app. When set, middleware redirects all requests with a different host to this one (308 redirect). Email links, OAuth callbacks, and webhooks all use this hostname. Unset for development; set in production when a custom domain is active.
APP_CANONICAL_HOST=

# === AUTH ===
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# === ZOOM ===
# Zoom OAuth app credentials for the Zoom meeting-link integration.
# Create an app at https://marketplace.zoom.us → Build App → OAuth.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# The redirect URI registered in your Zoom OAuth app.
# Must match exactly — e.g. https://yourapp.com/api/auth/zoom/callback
ZOOM_REDIRECT_URI=
# No longer read. Zoom state is signed with STATE_SIGNING_SECRET like every
# other OAuth flow (S2, 2026-09-14). The old chain fell back to a string
# literal in the repository when none of its three vars were set. Left here
# so anyone who has it in Vercel knows it is now inert and can be deleted.
ZOOM_STATE_SECRET=

# === CALENDLY ===
# Personal API token for the single-tenant fallback (used if no per-venue OAuth
# token exists in the DB). Generate at https://calendly.com/integrations/api_webhooks
CALENDLY_API_TOKEN=
# Calendly OAuth app credentials for multi-venue connections.
# Create an app at https://developer.calendly.com → OAuth Applications.
CALENDLY_OAUTH_CLIENT_ID=
CALENDLY_OAUTH_CLIENT_SECRET=
# Signing key for validating Calendly webhook payloads.
# Found under your Calendly webhook subscription settings.
# Fails CLOSED: with this unset, /api/webhooks/calendly answers 503 and never
# parses the body, so an unsigned POST cannot create tour_booked events or
# cancel a real tour. Calendly retries, so a short gap is recoverable.
CALENDLY_WEBHOOK_SECRET=

# === INSTAGRAM DMs (Meta Messaging API) ===
# Wave 3 W28. Inbound Instagram direct messages become signals on the
# spine with the sender's handle attached. Until all three are set the
# webhook at /api/webhooks/instagram answers 503 and the settings page at
# /settings/integrations/instagram shows a not-configured state. Nothing
# crashes; nothing arrives.
#
# App id and secret come from the Meta app (developers.facebook.com ->
# your app -> Settings -> Basic). The app secret is also the HMAC key Meta
# signs every webhook body with.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# A string you invent. Paste the same value into the Meta webhook form
# (Webhooks -> Instagram -> Verify token) and here.
# Generate with: openssl rand -hex 24
INSTAGRAM_VERIFY_TOKEN=
# The per-venue page access token is NOT an env var by default: it is
# minted per Facebook Page by the OAuth flow and stored on
# instagram_connections (migration 401). To keep it out of the database
# instead, put it in an env var of your choosing and write that var's NAME
# into instagram_connections.page_token_env_key.

# === AD SPEND CONNECTORS (W54) ===
# Real daily spend, impressions, clicks and conversions per campaign,
# replacing the typed-in figures on /intel/marketing-spend. Each platform
# is independent: a venue can connect one and leave the others on manual
# entry, and the reallocation page says which is which per venue.
#
# Until a platform's variables are set, its settings page shows a
# not-configured state and its connector refuses with 'not_configured'.
# Nothing crashes; nothing arrives. Going live is an operator step, the
# same shape as Instagram DMs waiting on Meta credentials.
#
# The anti-forgery token on all three connect flows is signed with
# STATE_SIGNING_SECRET above, so that must be set too. It is single-use and
# bound to the user who clicked Connect.

# --- Google Ads ---
# Cloud project with the Google Ads API enabled -> Credentials -> OAuth
# client ID (Web application). The redirect URI must be the full https URL
# ending in /api/integrations/google-ads/oauth/callback. The developer
# token comes from the Google Ads console (Tools -> API Center); the basic
# tier is enough for read-only access.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_REDIRECT_URI=

# --- Meta Ads ---
# Meta app (developers.facebook.com) with the Marketing API product added
# and the ads_read + business_management permissions requested. Redirect
# URI must end in /api/integrations/meta-ads/oauth/callback.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_OAUTH_REDIRECT_URI=
# The per-venue token is NOT an env var by default: it is minted per ad
# account by the connect flow and stored on meta_ads_connections
# (migration 407). To keep it out of the database instead, put it in an
# env var of your choosing and write that var's NAME into
# meta_ads_connections.token_env_key.

# --- TikTok Ads ---
# TikTok for Business developer portal -> your app. Redirect URI must end
# in /api/integrations/tiktok-ads/oauth/callback.
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
TIKTOK_ADS_OAUTH_REDIRECT_URI=
# Same env-var-name option as Meta above, via
# tiktok_ads_connections.token_env_key.

# === CRON ===
# Bearer token for every /api/cron route and every admin ops endpoint that
# accepts a machine caller. Vercel's scheduler sends it automatically.
# MUST be 32+ random bytes: `openssl rand -hex 32`. Shorter than 32
# characters is REFUSED outright in production (VERCEL_ENV=production), and
# unset fails closed with a 503 on every route that reads it — nothing runs
# on a half-configured deploy. Verified in constant time by
# src/lib/cron-auth.ts; routes must never compare it inline (CI guard:
# scripts/check-cron-auth-helper.mjs).
CRON_SECRET=
# Second tier for destructive jobs — merges, prunes, deletes, outbound email,
# and the Sonnet-spending sweeps listed in DESTRUCTIVE_JOBS in
# src/lib/cron-auth.ts. Those jobs then need either a vercel-cron user-agent
# or an explicit X-Destructive-Secret header carrying this value, so a leaked
# CRON_SECRET alone cannot fire them. Fails CLOSED: in production, a
# destructive job answers 503 while this is unset. Outside production it is
# allowed with a logged warning so a sweep can still be run by hand.
# Generate with: openssl rand -hex 32
CRON_SECRET_DESTRUCTIVE=

# === TRANSACTIONAL EMAIL (Resend) ===
# Used for couple invitations and as a fallback for daily digests when a
# venue's Gmail isn't connected. If RESEND_API_KEY is blank, sendEmail
# falls back to console.log so local dev still works.
RESEND_API_KEY=
EMAIL_FROM=The Bloom House <hello@thebloomhouse.ai>

# === DEMO ===
# Demo mode is cookie-based — visit /demo to activate. The demo cookie is now
# HMAC-signed server-side; this secret is REQUIRED for the /demo entry to work.
# Generate with: openssl rand -hex 32
DEMO_SIGNING_SECRET=
# W58: comma-separated origin allow-list for the public, no-auth
# /api/public/demo-snapshot route the marketing site's live demo polls. An
# origin not in this list gets a 403 before any database read. Leave blank
# in local dev to allow same-origin-only (no browser CORS needed) calls.
PUBLIC_DEMO_ALLOWED_ORIGINS=

# === FEATURE FLAGS ===
# Set '1' to use cluster-level first-touch attribution instead of per-lead first touch.
# Affects attribution-parity computation (lib/services/attribution-parity.ts).
USE_CLUSTER_FIRST_TOUCH=
# Set '1' to suppress heat-map signals whose confidence score is below threshold.
# When unset, all signals fire regardless of confidence (lib/services/anomaly-detection.ts).
HEAT_RESPECTS_CONFIDENCE=

# === TEST / E2E ===
# Secret required to call the test-harness endpoint (/api/admin/test-harness).
# Never expose in production; route is guarded to non-prod only.
# Generate with: openssl rand -hex 32
TEST_HARNESS_SECRET=
# Base URL for the E2E data-flow test script (scripts/e2e-data-flow-test.mjs).
# If unset, the script defaults to http://localhost:<E2E_PORT>.
E2E_BASE_URL=
# Port the local dev server listens on during E2E tests. Defaults to 3100.
E2E_PORT=3100

# === SCRIPTS ===
# Venue UUID for one-off Rixey scripts (scripts/recover-gmail-window.ts).
# Falls back to the hardcoded Rixey venue ID if unset.
# S5 (2026-09-14 security audit, item 12): blanked. A real customer's
# venue id was checked into the example file, which is the file people
# paste into tickets and screenshots. It is not a secret on its own, but
# it is the key every venue-scoped query in this codebase takes, so it
# does not belong in a committed sample.
RIXEY_VENUE_ID=
# Base URL for verification scripts that hit the live app API
# (scripts/rixey-load/57-jjj-verify.ts, 61-kkk-verify.ts).
# Leave unset to skip the live-endpoint checks in those scripts.
BLOOM_BASE_URL=
# Session cookie value for live-endpoint checks in verification scripts.
# Set to the value of your browser session cookie after logging in.
# Leave unset to skip authenticated checks.
BLOOM_COOKIE=

# === STRIPE ===
# Secret + webhook secret. Use sk_test_/whsec_ in dev, sk_live_/whsec_ in prod.
STRIPE_SECRET_KEY=
# Fails CLOSED: with this unset, /api/webhooks/stripe answers 503 and never
# parses the body. It used to log a warning and process the payload anyway,
# which let an unsigned POST move a venue onto a paid plan. Stripe retries
# and the dashboard can replay, so a short gap is recoverable.
STRIPE_WEBHOOK_SECRET=
# Price IDs for subscription plans. Create these in the Stripe dashboard.
# "Intelligence" = mid tier, "Enterprise" = top tier. Starter is free (no price).
STRIPE_PRICE_INTELLIGENCE_MONTHLY=price_xxx
STRIPE_PRICE_INTELLIGENCE_ANNUAL=price_xxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxx
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_xxx
# Public base URL for building success/cancel URLs. Falls back to request origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === OPERATOR / CI ONLY (not read by the app) ===
# Two-venue isolation battery (W38): a NON-production project holding two venues. CI skips when unset.
ISOLATION_SUPABASE_URL=
ISOLATION_SERVICE_KEY=
# apply-pending-migrations.ts and run-migration.ts read this file instead of .env.local when set
# (or pass --env). Production is refused by URL either way.
MIGRATION_ENV_FILE=
# Set to 1 to render the scaffold pages hidden by W39 (PLATFORM-PAGES-AUDIT.md).
SCAFFOLD_PAGES=
