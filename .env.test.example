# D-12 — golden-harness test DB.
# Copy to `.env.test` and fill with a NON-PROD Supabase (a branch off prod,
# or a fresh scratch project — anything with the CURRENT schema). The golden
# harness reads .env.test in preference to .env.local and HARD-REFUSES the
# prod project ref (jsxxgwprxuqgcauzlxcb).
#
# After filling: `npx tsx scripts/seed-golden-venue.ts` then `npm run test:golden`.
NEXT_PUBLIC_SUPABASE_URL=https://<your-test-branch-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<test-branch service_role key>
GOLDEN_TEST_VENUE=0a17e57e-0000-4000-8000-000000000001
